% Exercise 1:

A = [3, 2, 8, 1; 7, 2, 5, 6; 0, 7, 3, 5];

% Transpose:
A' 

% Extracting elements and vectors:
A(2,3)
A(:,[1,4])
A([2,3],[3,1])
A(:,1:2:end)
A(:)
[A; A(end,:)]

% Operations 
A+eye(3,4)
A-3
A(end:-1:1,:)
A.^2
exp(A)

% Misc:
fliplr(A)
diag(A)
diag(diag(A))
tril(A)
triu(A)
size(A)
max(A)
max(max(A))

%boolean:
A == 2
A ~= 2
A > 2


% Exercise 2:

A = [3, 1, 6; 5, 2, 7];
x = [1, 4, 8];
y = [2, 1, 5];

% Operations:
x + y
x + A
x' + y

% A - [x' y'] throws an error, we have 2 x 3 and 3 x 2 matrices, so we can
% do the following:
A - [x' y']'
A' - [x' y']

% [x; y'] is a matrix with the first row being a row vecor x, second row
% cannot be a column vector y', as it's a column

[x; y]


% Exercise 3:

A1 = ceil(10*rand(5));
A2 = floor(10*rand(3));

A3 = zeros(8, 8)
A3(1:5,1:5) = A1
A3(6:8,6:8) = A2

A3(6:8,1:3) = eye(3,3)